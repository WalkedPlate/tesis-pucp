        <mxCell id="nota" value="El veredicto se refiere &#250;nicamente a la capacidad de decidir antes de que la operaci&#243;n llegue al productor. Si una petici&#243;n permitida falla despu&#233;s por indisponibilidad o por un problema de ruta, se registra como fallo de realizaci&#243;n en ejecuci&#243;n y no modifica el veredicto." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C4C4C4;fontColor=#4D4D4D;fontSize=11;fontFamily=Times New Roman;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=12;strokeWidth=2;" vertex="1" parent="1">

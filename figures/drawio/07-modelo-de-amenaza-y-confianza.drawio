        <mxCell id="t2" value="Un atributo que el actor controlado puede escribir no sirve para identificarlo" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#666666;fontFamily=Times New Roman" vertex="1" parent="L2">

<mxfile host="app.diagrams.net" agent="Claude" type="device">
  <diagram id="fig07" name="Modelo de amenaza y confianza">
    <mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="826" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" value="Diagrama" parent="0" />
        <mxCell id="L2" value="Titulo" parent="0" />

        <mxCell id="pod" value="&lt;b&gt;NF consumidora comprometida&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#4D4D4D&quot;&gt;Conserva su identidad de red y sus credenciales, y puede escribir la metadata no protegida de sus propias peticiones.&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FBEDEB;strokeColor=#B03A2E;fontColor=#7B2A21;fontSize=12;fontFamily=Times New Roman;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;spacingRight=10;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="60" y="120" width="270" height="150" as="geometry" />
        </mxCell>
        <mxCell id="pep" value="&lt;b&gt;PEP L7&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;decide seg&#250;n la cabecera observada&lt;/span&gt;" style="shape=hexagon;perimeter=hexagonPerimeter2;fixedSize=1;whiteSpace=wrap;html=1;fillColor=#FBF3E4;strokeColor=#B58133;fontColor=#6E4E17;fontSize=12;fontFamily=Times New Roman;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="450" y="120" width="150" height="150" as="geometry" />
        </mxCell>
        <mxCell id="o1" value="petici&#243;n &lt;b&gt;denegada&lt;/b&gt;" style="rounded=1;absoluteArcSize=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FBEDEB;strokeColor=#B03A2E;fontColor=#7B2A21;fontSize=12;fontFamily=Times New Roman;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="670" y="130" width="180" height="55" as="geometry" />
        </mxCell>
        <mxCell id="o2" value="petici&#243;n &lt;b&gt;admitida&lt;/b&gt;" style="rounded=1;absoluteArcSize=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EDF5F0;strokeColor=#3B7A57;fontColor=#2A5A40;fontSize=12;fontFamily=Times New Roman;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="670" y="210" width="180" height="55" as="geometry" />
        </mxCell>

        <mxCell id="concl" value="Desde el mismo pod y con la misma identidad de red, el resultado cambia s&#243;lo porque cambia una cabecera que el propio actor escribe. El atributo permite diferenciar mensajes, pero no autentica su procedencia." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C4C4C4;fontColor=#4D4D4D;fontSize=11;fontFamily=Times New Roman;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=12;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="60" y="300" width="790" height="70" as="geometry" />
        </mxCell>

        <mxCell id="ltit" value="&lt;b&gt;Escala de confianza de los observables&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#777777&quot;&gt;de mayor a menor confianza&lt;/span&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#333333;fontFamily=Times New Roman" vertex="1" parent="1">
          <mxGeometry x="885" y="96" width="250" height="34" as="geometry" />
        </mxCell>
        <mxCell id="T3" value="&lt;b&gt;T3&lt;/b&gt;&#160; principal autenticado: identidad de red verificada o certificado" style="rounded=1;absoluteArcSize=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EDF5F0;strokeColor=#3B7A57;fontColor=#2A5A40;fontSize=11;fontFamily=Times New Roman;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=10;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="885" y="138" width="245" height="66" as="geometry" />
        </mxCell>
        <mxCell id="T2" value="&lt;b&gt;T2&lt;/b&gt;&#160; metadata con procedencia de la infraestructura" style="rounded=1;absoluteArcSize=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F4F4F4;strokeColor=#7A7A7A;fontColor=#333333;fontSize=11;fontFamily=Times New Roman;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=10;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="885" y="212" width="245" height="66" as="geometry" />
        </mxCell>
        <mxCell id="T1" value="&lt;b&gt;T1&lt;/b&gt;&#160; metadata efectiva para el enrutamiento, controlable por el consumidor" style="shape=hexagon;perimeter=hexagonPerimeter2;fixedSize=1;whiteSpace=wrap;html=1;fillColor=#FBF3E4;strokeColor=#B58133;fontColor=#6E4E17;fontSize=11;fontFamily=Times New Roman;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=10;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="885" y="286" width="245" height="66" as="geometry" />
        </mxCell>
        <mxCell id="T0" value="&lt;b&gt;T0&lt;/b&gt;&#160; metadata autoafirmada por el consumidor (User-Agent)" style="rounded=1;absoluteArcSize=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FBEDEB;strokeColor=#B03A2E;fontColor=#7B2A21;fontSize=11;fontFamily=Times New Roman;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=10;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="885" y="360" width="245" height="66" as="geometry" />
        </mxCell>

        <mxCell id="banda" value="&lt;b&gt;Visibilidad no equivale a observabilidad confiable.&lt;/b&gt;&#160; Un discriminador visible en L7 puede devolver la capacidad de distinguir peticiones sin devolver la capacidad de aplicar la pol&#237;tica de forma segura." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F7F7F7;strokeColor=#9A9A9A;fontColor=#333333;fontSize=12;fontFamily=Times New Roman;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=14;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="60" y="470" width="1070" height="62" as="geometry" />
        </mxCell>

        <mxCell id="rf" value="&lt;b&gt;Realizabilidad funcional&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#4D4D4D&quot;&gt;El PEP distingue las peticiones cuando la metadata es honesta. Basta para diferenciar, no para autenticar.&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8C8C8C;fontColor=#333333;fontSize=12;fontFamily=Times New Roman;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;spacingRight=10;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="60" y="565" width="520" height="120" as="geometry" />
        </mxCell>
        <mxCell id="rs" value="&lt;b&gt;Realizabilidad segura&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#4D4D4D&quot;&gt;El discriminador conserva una procedencia confiable frente al actor comprometido definido en el modelo de amenaza.&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8C8C8C;fontColor=#333333;fontSize=12;fontFamily=Times New Roman;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;spacingRight=10;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="610" y="565" width="520" height="120" as="geometry" />
        </mxCell>

        <mxCell id="e1" value="User-Agent: SMF" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#5A5A5A;fontSize=10;fontColor=#666666;fontFamily=Times New Roman;endArrow=block;endFill=1;endSize=8;exitX=1;exitY=0.25;exitDx=0;exitDy=0;entryX=0;entryY=0.25;entryDx=0;entryDy=0;verticalAlign=bottom" edge="1" parent="1" source="pod" target="pep">

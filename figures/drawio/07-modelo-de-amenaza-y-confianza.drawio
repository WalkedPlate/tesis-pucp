        <mxCell id="t1" value="Modelo de amenaza y confianza de los observables" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=16;fontStyle=1;fontColor=#1A1A1A;fontFamily=Times New Roman" vertex="1" parent="L2">

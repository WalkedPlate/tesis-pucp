        <mxCell id="e2" value="User-Agent: AMF" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#5A5A5A;fontSize=10;fontColor=#666666;fontFamily=Times New Roman;endArrow=block;endFill=1;endSize=8;exitX=1;exitY=0.75;exitDx=0;exitDy=0;entryX=0;entryY=0.75;entryDx=0;entryDy=0;verticalAlign=bottom" edge="1" parent="1" source="pod" target="pep">

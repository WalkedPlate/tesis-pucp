<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="26.0.0">
  <diagram name="Cadena de decision">
    <mxGraphModel dx="1500" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="810" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="2" value="Intent y perfil&#xa;de ejecución" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;fixedSize=1;fillColor=#F4F4F4;strokeColor=#5A5A5A;strokeWidth=2;fontColor=#333333;fontFamily=Times New Roman;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="40" y="205" width="160" height="80" as="geometry" />
        </mxCell>

        <mxCell id="3" value="Cadena de comprobaciones" style="swimlane;startSize=30;html=1;whiteSpace=wrap;fillColor=none;strokeColor=#9A9A9A;strokeWidth=2;dashed=1;dashPattern=8 4;fontFamily=Times New Roman;fontSize=13;fontStyle=1;fontColor=#4D4D4D;align=left;spacingLeft=12;pointerEvents=0;" vertex="1" parent="1">
          <mxGeometry x="240" y="90" width="940" height="250" as="geometry" />
        </mxCell>

        <mxCell id="10" value="El discriminador ya existe en el estado de la petición" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Times New Roman;fontSize=11;fontColor=#4D4D4D;" vertex="1" parent="3">
          <mxGeometry x="5" y="35" width="210" height="55" as="geometry" />
        </mxCell>
        <mxCell id="11" value="&lt;b&gt;1&lt;/b&gt;&#xa;¿Materializado?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#EDF2F8;strokeColor=#4A6D96;strokeWidth=2;fontColor=#1F3A5F;fontFamily=Times New Roman;fontSize=13;" vertex="1" parent="3">
          <mxGeometry x="15" y="95" width="190" height="120" as="geometry" />
        </mxCell>

        <mxCell id="12" value="El PEP lo observa con la procedencia que exige el modelo de amenaza" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Times New Roman;fontSize=11;fontColor=#4D4D4D;" vertex="1" parent="3">
          <mxGeometry x="235" y="35" width="210" height="55" as="geometry" />
        </mxCell>
        <mxCell id="13" value="&lt;b&gt;2&lt;/b&gt;&#xa;¿Observable&#xa;y confiable?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#EDF2F8;strokeColor=#4A6D96;strokeWidth=2;fontColor=#1F3A5F;fontFamily=Times New Roman;fontSize=13;" vertex="1" parent="3">
          <mxGeometry x="245" y="95" width="190" height="120" as="geometry" />
        </mxCell>

        <mxCell id="14" value="El lenguaje representa el predicado que el intent exige" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Times New Roman;fontSize=11;fontColor=#4D4D4D;" vertex="1" parent="3">
          <mxGeometry x="465" y="35" width="210" height="55" as="geometry" />
        </mxCell>
        <mxCell id="15" value="&lt;b&gt;3&lt;/b&gt;&#xa;¿Expresable?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#EDF2F8;strokeColor=#4A6D96;strokeWidth=2;fontColor=#1F3A5F;fontFamily=Times New Roman;fontSize=13;" vertex="1" parent="3">
          <mxGeometry x="475" y="95" width="190" height="120" as="geometry" />
        </mxCell>

        <mxCell id="16" value="El mecanismo actúa antes de que la petición alcance al productor" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Times New Roman;fontSize=11;fontColor=#4D4D4D;" vertex="1" parent="3">
          <mxGeometry x="695" y="35" width="210" height="55" as="geometry" />
        </mxCell>
        <mxCell id="17" value="&lt;b&gt;4&lt;/b&gt;&#xa;¿Accionable?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#EDF2F8;strokeColor=#4A6D96;strokeWidth=2;fontColor=#1F3A5F;fontFamily=Times New Roman;fontSize=13;" vertex="1" parent="3">
          <mxGeometry x="705" y="95" width="190" height="120" as="geometry" />
        </mxCell>

        <mxCell id="4" value="&lt;b&gt;R&lt;/b&gt;&#xa;realizable" style="shape=doubleEllipse;whiteSpace=wrap;html=1;fillColor=#EDF5F0;strokeColor=#3B7A57;strokeWidth=2;fontColor=#2A5A40;fontFamily=Times New Roman;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="1220" y="200" width="140" height="90" as="geometry" />
        </mxCell>

        <mxCell id="5" value="&lt;b&gt;U (F1)&lt;/b&gt;&#xa;El discriminador todavía no existe cuando el PEP decide." style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FBEDEB;strokeColor=#B03A2E;strokeWidth=2;fontColor=#7B2A21;fontFamily=Times New Roman;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="245" y="420" width="210" height="130" as="geometry" />
        </mxCell>
        <mxCell id="6" value="&lt;b&gt;U (F2)&lt;/b&gt;&#xa;Existe, pero no es visible, está cifrado o lo escribe un actor no confiable." style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FBEDEB;strokeColor=#B03A2E;strokeWidth=2;fontColor=#7B2A21;fontFamily=Times New Roman;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="475" y="420" width="210" height="130" as="geometry" />
        </mxCell>
        <mxCell id="7" value="&lt;b&gt;U (F3)&lt;/b&gt;&#xa;La información confiable está disponible, pero el lenguaje no representa el predicado o el mecanismo no ejecuta la acción." style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FBEDEB;strokeColor=#B03A2E;strokeWidth=2;fontColor=#7B2A21;fontFamily=Times New Roman;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="705" y="420" width="440" height="130" as="geometry" />
        </mxCell>

        <mxCell id="8" value="&lt;b&gt;Realización en ejecución.&lt;/b&gt;&#xa;Una petición permitida puede fallar después por indisponibilidad del productor o por un problema de ruta. Ese resultado se registra como RUNTIME_REALIZATION_FAILURE y no modifica el veredicto anterior." style="shape=note;size=20;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9A9A9A;strokeWidth=1;fontColor=#4D4D4D;fontFamily=Times New Roman;fontSize=12;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=20;" vertex="1" parent="1">
          <mxGeometry x="40" y="680" width="1350" height="100" as="geometry" />
        </mxCell>

        <mxCell id="90" value="Leyenda" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#9A9A9A;verticalAlign=top;align=left;spacingLeft=10;fontStyle=1;fontFamily=Times New Roman;fontSize=12;fontColor=#4D4D4D;" vertex="1" parent="1">

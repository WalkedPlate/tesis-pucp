        <mxCell id="intent" value="&lt;b&gt;Intent de contenci&#243;n selectiva:&lt;/b&gt;&#160; bloquear las peticiones dirigidas a UDM_a y permitir las dirigidas a UDM_b" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F7F7F7;strokeColor=#9A9A9A;fontColor=#333333;fontSize=12;fontFamily=Times New Roman;align=center;verticalAlign=middle;strokeWidth=2;" vertex="1" parent="1">

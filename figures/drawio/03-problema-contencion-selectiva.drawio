        </mxCell>

        <mxCell id="c1" value="&lt;b&gt;1. Materializaci&#243;n&lt;/b&gt;&lt;br&gt;&#191;la instancia productora ya fue seleccionada cuando el PEP decide?" style="rounded=1;absoluteArcSize=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8C8C8C;fontColor=#333333;fontSize=11;fontFamily=Times New Roman;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;spacingRight=8;strokeWidth=2;" vertex="1" parent="1">

        <mxCell id="cons" value="&lt;b&gt;NF consumidora&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#5A5A5A&quot;&gt;escribe las cabeceras de sus propias peticiones&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EDF2F8;strokeColor=#4A6D96;fontColor=#1F3A5F;fontSize=12;fontFamily=Times New Roman;strokeWidth=2;" vertex="1" parent="1">

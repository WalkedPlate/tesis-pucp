        <mxCell id="c4" value="&lt;b&gt;4. Acci&#243;n&lt;/b&gt;&lt;br&gt;&#191;el mecanismo puede expresar el predicado y aplicarlo de forma preventiva?" style="rounded=1;absoluteArcSize=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8C8C8C;fontColor=#333333;fontSize=11;fontFamily=Times New Roman;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;spacingRight=8;strokeWidth=2;" vertex="1" parent="1">

        <mxCell id="c3" value="&lt;b&gt;3. Confianza&lt;/b&gt;&lt;br&gt;&#191;qui&#233;n gener&#243; el atributo y puede alterarlo el actor que se desea controlar?" style="rounded=1;absoluteArcSize=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8C8C8C;fontColor=#333333;fontSize=11;fontFamily=Times New Roman;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;spacingRight=8;strokeWidth=2;" vertex="1" parent="1">

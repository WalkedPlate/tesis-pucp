        </mxCell>
        <mxCell id="udmb" value="&lt;b&gt;UDM_b&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;destino permitido&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EDF5F0;strokeColor=#3B7A57;fontColor=#2A5A40;fontSize=12;fontFamily=Times New Roman;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="950" y="235" width="160" height="60" as="geometry" />
        </mxCell>

        <mxCell id="obsa" value="&lt;b&gt;Qu&#233; observa aqu&#237;&lt;/b&gt;&lt;br&gt;&#183; la identidad de red del consumidor&lt;br&gt;&#183; el SCP como destino de red&lt;br&gt;&#183; cabeceras L7 escritas por el propio consumidor" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C4C4C4;fontColor=#4D4D4D;fontSize=11;fontFamily=Times New Roman;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="270" y="330" width="215" height="130" as="geometry" />
        </mxCell>
        <mxCell id="obsm" value="&lt;b&gt;Qu&#233; ocurre aqu&#237;&lt;/b&gt;&lt;br&gt;&#183; puede materializarse la selecci&#243;n de la instancia&lt;br&gt;&#183; pueden transformarse las cabeceras" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C4C4C4;fontColor=#4D4D4D;fontSize=11;fontFamily=Times New Roman;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="500" y="330" width="180" height="130" as="geometry" />
        </mxCell>
        <mxCell id="obsb" value="&lt;b&gt;Qu&#233; observa aqu&#237;&lt;/b&gt;&lt;br&gt;&#183; la instancia productora, si ya se materializ&#243;&lt;br&gt;&#183; deja de ver la identidad del consumidor original" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C4C4C4;fontColor=#4D4D4D;fontSize=11;fontFamily=Times New Roman;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="700" y="330" width="215" height="130" as="geometry" />
        </mxCell>

        <mxCell id="preg" value="&lt;b&gt;El problema:&lt;/b&gt; el lenguaje de pol&#237;ticas admite escribir el intent, pero el punto de ejecuci&#243;n elegido puede no disponer, al decidir, de un discriminador que separe UDM_a de UDM_b." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F7F7F7;strokeColor=#9A9A9A;fontColor=#333333;fontSize=12;fontFamily=Times New Roman;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=14;strokeWidth=2;" vertex="1" parent="1">

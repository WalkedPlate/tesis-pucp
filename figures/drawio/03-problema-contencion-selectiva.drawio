          <mxGeometry x="730" y="180" width="150" height="80" as="geometry" />
        </mxCell>
        <mxCell id="udma" value="&lt;b&gt;UDM_a&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;destino que debe bloquearse&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FBEDEB;strokeColor=#B03A2E;fontColor=#7B2A21;fontSize=12;fontFamily=Times New Roman;strokeWidth=2;" vertex="1" parent="1">

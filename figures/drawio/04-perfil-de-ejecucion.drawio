        </mxCell>
        <mxCell id="U" value="&lt;b&gt;U &#8212; no realizable&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;exige identificar la causa&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FBEDEB;strokeColor=#B03A2E;fontColor=#7B2A21;fontSize=12;fontFamily=Times New Roman;strokeWidth=2;" vertex="1" parent="1">

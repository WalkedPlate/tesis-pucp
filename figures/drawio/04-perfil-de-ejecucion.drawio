        </mxCell>

        <mxCell id="eval" value="&lt;b&gt;Enf(I | &#928;)&lt;/b&gt;&lt;br&gt;&#191;puede este PEP aplicar el intent I en este perfil?" style="rounded=1;absoluteArcSize=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F7F7F7;strokeColor=#666666;fontColor=#333333;fontSize=12;fontFamily=Times New Roman;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="390" y="325" width="390" height="85" as="geometry" />
        </mxCell>

        <mxCell id="nota" value="Si la decisi&#243;n es correcta y la entrega falla despu&#233;s (productor ca&#237;do o problema de ruta), se registra como &lt;b&gt;fallo de realizaci&#243;n en ejecuci&#243;n&lt;/b&gt; y no modifica el veredicto." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C4C4C4;fontColor=#4D4D4D;fontSize=11;fontFamily=Times New Roman;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=10;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="830" y="325" width="270" height="85" as="geometry" />
        </mxCell>

        <mxCell id="R" value="&lt;b&gt;R &#8212; realizable&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;el PEP puede aplicar la pol&#237;tica en ese perfil&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EDF5F0;strokeColor=#3B7A57;fontColor=#2A5A40;fontSize=12;fontFamily=Times New Roman;strokeWidth=2;" vertex="1" parent="1">

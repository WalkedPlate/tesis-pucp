        </mxCell>

        <mxCell id="F1" value="&lt;b&gt;F1&lt;/b&gt; &#8212; Informaci&#243;n a&#250;n no materializada&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#4D4D4D&quot;&gt;La instancia todav&#237;a no ha sido seleccionada cuando el PEP decide. M&#225;s visibilidad no crea una selecci&#243;n que a&#250;n no ocurri&#243;.&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8C8C8C;fontColor=#333333;fontSize=12;fontFamily=Times New Roman;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;spacingRight=10;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="140" y="595" width="290" height="150" as="geometry" />
        </mxCell>
        <mxCell id="F2" value="&lt;b&gt;F2&lt;/b&gt; &#8212; Materializada pero no observable de forma confiable&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#4D4D4D&quot;&gt;No visible, oculta por el cifrado, transformada por el SCP, o visible pero autoafirmada por el propio actor.&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8C8C8C;fontColor=#333333;fontSize=12;fontFamily=Times New Roman;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;spacingRight=10;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="440" y="595" width="290" height="150" as="geometry" />
        </mxCell>
        <mxCell id="F3" value="&lt;b&gt;F3&lt;/b&gt; &#8212; Confiable pero no expresable ni accionable&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#4D4D4D&quot;&gt;El mecanismo no puede representar el predicado requerido o no puede ejecutar la acci&#243;n preventiva.&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8C8C8C;fontColor=#333333;fontSize=12;fontFamily=Times New Roman;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;spacingRight=10;strokeWidth=2;" vertex="1" parent="1">

        <mxCell id="L2" value="Titulo" parent="0" />

        <mxCell id="A" value="&lt;b&gt;A&lt;/b&gt; &#8212; Arquitectura&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#4D4D4D&quot;&gt;Comunicaci&#243;n directa o indirecta. Condiciona d&#243;nde ocurre el descubrimiento y la selecci&#243;n.&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EDF2F8;strokeColor=#4A6D96;fontColor=#1F3A5F;fontSize=12;fontFamily=Times New Roman;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;spacingRight=10;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="70" y="110" width="190" height="140" as="geometry" />
        </mxCell>
        <mxCell id="C" value="&lt;b&gt;C&lt;/b&gt; &#8212; Estado de la petici&#243;n&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#4D4D4D&quot;&gt;Descubrimiento, selecci&#243;n, vinculaci&#243;n a un recurso y reselecci&#243;n. Es propio de cada petici&#243;n.&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EDF2F8;strokeColor=#4A6D96;fontColor=#1F3A5F;fontSize=12;fontFamily=Times New Roman;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;spacingRight=10;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="280" y="110" width="190" height="140" as="geometry" />
        </mxCell>
        <mxCell id="P" value="&lt;b&gt;P&lt;/b&gt; &#8212; Perfil del PEP&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#4D4D4D&quot;&gt;Ubicaci&#243;n en el trayecto (antes o despu&#233;s del SCP) y capa de operaci&#243;n (L3/L4 o L7).&lt;/span&gt;" style="shape=hexagon;perimeter=hexagonPerimeter2;fixedSize=1;whiteSpace=wrap;html=1;fillColor=#FBF3E4;strokeColor=#B58133;fontColor=#6E4E17;fontSize=12;fontFamily=Times New Roman;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;spacingRight=10;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="490" y="110" width="190" height="140" as="geometry" />
        </mxCell>
        <mxCell id="O" value="&lt;b&gt;O&#964;&lt;/b&gt; &#8212; Observables confiables&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#4D4D4D&quot;&gt;Atributos materializados y visibles, junto con su procedencia frente al modelo de amenaza.&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EDF2F8;strokeColor=#4A6D96;fontColor=#1F3A5F;fontSize=12;fontFamily=Times New Roman;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;spacingRight=10;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="700" y="110" width="190" height="140" as="geometry" />
        </mxCell>
        <mxCell id="L" value="&lt;b&gt;L&lt;/b&gt; &#8212; Lenguaje y acci&#243;n&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#4D4D4D&quot;&gt;Predicados que el mecanismo puede representar y ejecutar de forma preventiva.&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EDF2F8;strokeColor=#4A6D96;fontColor=#1F3A5F;fontSize=12;fontFamily=Times New Roman;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;spacingRight=10;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="910" y="110" width="190" height="140" as="geometry" />
        </mxCell>

